root = true

[*.cs]
# Culture: these run only in the analysis build (InvariantGlobalization=false).
dotnet_diagnostic.CA1304.severity = error
dotnet_diagnostic.CA1305.severity = error
dotnet_diagnostic.CA1307.severity = error
dotnet_diagnostic.CA1309.severity = error
dotnet_diagnostic.CA1310.severity = error
dotnet_diagnostic.CA1311.severity = error
# Every native handle, statement and transaction is disposed.
dotnet_diagnostic.CA2000.severity = error
# The one catch-all lives in Program.Main.
dotnet_diagnostic.CA1031.severity = error
# AOT and trim.
dotnet_diagnostic.IL2026.severity = error
dotnet_diagnostic.IL3050.severity = error
# Banned symbols (BannedSymbols.txt).
dotnet_diagnostic.RS0030.severity = error
# No async at all, so these back up the Task ban.
dotnet_diagnostic.VSTHRD100.severity = error
dotnet_diagnostic.VSTHRD103.severity = error
dotnet_diagnostic.VSTHRD110.severity = error
dotnet_diagnostic.CA1849.severity = error
# A switch over an enum names every member (CS8509 stays an error, so a new
# member without a case does not build); a cast to an unnamed value is not a case.
dotnet_diagnostic.CS8524.severity = none
# Rules that are not gates here.
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1812.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1032.severity = none
dotnet_diagnostic.CA1308.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1716.severity = none
