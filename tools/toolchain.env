# The toolchain bin/ is built with, in one place. tools/toolchain.sh installs it into IMAGE, and
# both tools/build-in-container.sh and .github/workflows/verify-bin.yml run that script.
# The base image, by digest; the tag names the day Docker Hub built it.
IMAGE=archlinux:base-20261004.0.606936@sha256:4e77cf2ea5f410e6f8be5abf93ccf17ce2436e87a138c167208356711a405dbd
# The Arch Linux Archive day whose repos hold the clang, lld, llvm, gcc, glibc and binutils of bin/BUILD.json.
ALA_DATE=2026/08/24
DOTNET_SDK=10.0.401
# The sha512 that releases.json of the 10.0 channel publishes for the linux-x64 tarball.
DOTNET_SDK_SHA512=51c8b999af9e8dd9998c9edc5944e19a90788862068acd38694e098889054ce8c23d4f0c5cccfa16bf187d044562359e5ee69a9f8ad0bbe913ba90311fbce25b
# The sysroot packages tarball of the pre-release sysroot-<first 12 hex of sha256(tools/sysroot.lock)>.
# A new tools/sysroot.lock needs a new release asset and this hash with it.
SYSROOT_TAR_SHA256=dca1eca63e1f3c72d7818292c3d8af798b7d69a9151ed175ffa3473f85a21616
